{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forest Gap Detection",
  "version": "0.1.0",
  "identifier": "com.justine.fgd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forest Gap Detection — 油棕园空地检测",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../runtime/desktop_entry/**/*": "py-runtime/desktop_entry/"
    }
  }
}
